# NestAI Local Development Configuration Example
# Copy this file to '.env' and fill in your keys.

# Google Cloud Platform / Vertex AI configuration
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-east1

# Alternatively, for Google AI Studio (recommended for rapid local prototyping):
# GEMINI_API_KEY=your-gemini-api-key-here

# API keys for specialist services (to be configured in later phases)
# GOOGLE_MAPS_API_KEY=your-maps-api-key-here

# CORS configuration for frontend/backend communication
ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
